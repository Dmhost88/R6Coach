#!/bin/sh
# Refuse pushes to main: changes reach main only by a squash-merged pull request
# (see CONTRIBUTING.md). Turn it on once per clone:  git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: refusing to push to main. Push your branch and open a pull request:" >&2
    echo "  git push -u origin HEAD && gh pr create" >&2
    exit 1
  fi
done
exit 0
